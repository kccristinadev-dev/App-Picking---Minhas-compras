<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppPickingMinhasCompras.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppPickingMinhasCompras.Views">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        
        <ShellContent
            Title="Produtos"
            ContentTemplate="{DataTemplate local:ProdutosPage}"
            Route="ProdutosPage" />
        
        <ShellContent
            Title="Categorias"
            ContentTemplate="{DataTemplate local:CategoriasPage}"
            Route="CategoriasPage" />
    </TabBar>

</Shell>

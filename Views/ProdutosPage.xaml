<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppPickingMinhasCompras.Views.ProdutosPage"
             Title="Produtos">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="10">
        
    <!-- Formulário -->
<VerticalStackLayout Grid.Row="0" Spacing="10" Padding="10">
    ...
</VerticalStackLayout>

<!-- Busca -->
<SearchBar Grid.Row="1"
           Placeholder="Buscar produto..."
           Text="{Binding TextoBusca}"
           Margin="10,0"/>

<!-- Lista -->
<CollectionView Grid.Row="2"
                ItemsSource="{Binding ProdutosFiltrados}"
                Margin="10">

    <CollectionView.ItemTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="*,Auto"
                  Padding="10"
                  RowSpacing="5">

                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{Binding Nome}"
                           FontAttributes="Bold"
                           FontSize="16"/>

                    <Label Text="{Binding Descricao}"
                           FontSize="14"
                           Opacity="0.7"/>

                    <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                           FontSize="14"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding Quantidade, StringFormat='Qtd: {0}'}"
                           FontSize="12"/>
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Deletar"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProdutoCommand}"
                        CommandParameter="{Binding .}"
                        BackgroundColor="#FF0000"/>
            </Grid>
        </DataTemplate>
    </CollectionView.ItemTemplate>
</CollectionView>

<!-- Loading -->
<ActivityIndicator Grid.Row="2"
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}"
                    Color="#512BD4"/>